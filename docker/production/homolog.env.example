# APENAS EXEMPLO: copiar para .env.homolog e substituir credenciais/APP_KEY.
# NUNCA copiar segredos reais da VPS nem apontar homologacao para DB de producao.
SOS_IMAGE_TAG=VERSAO_TESTADA
APP_NAME=SOSMecanicaHomolog
APP_ENV=staging
APP_DEBUG=false
APP_KEY=GERAR_BASE64_UNICO
APP_URL=http://127.0.0.1:18080
LOG_CHANNEL=stack
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=sosmecanica_homolog
DB_USERNAME=sos_homolog
DB_PASSWORD=CRIAR_SENHA_FORTe
HOMOLOG_DB_PASSWORD=CRIAR_SENHA_FORTe
HOMOLOG_MYSQL_ROOT_PASSWORD=CRIAR_OUTRA_SENHA_FORTE
SESSION_DRIVER=database
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
